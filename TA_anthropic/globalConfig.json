{
    "pages": {
        "configuration": {
            "tabs": [
                {
                    "name": "account",
                    "table": {
                        "actions": [
                            "edit",
                            "delete",
                            "clone"
                        ],
                        "header": [
                            {
                                "label": "Name",
                                "field": "name"
                            }
                        ]
                    },
                    "entity": [
                        {
                            "type": "text",
                            "label": "Name",
                            "validators": [
                                {
                                    "type": "regex",
                                    "errorMsg": "Account Name must begin with a letter and consist exclusively of alphanumeric characters and underscores.",
                                    "pattern": "^[a-zA-Z]\\w*$"
                                },
                                {
                                    "type": "string",
                                    "errorMsg": "Length of input name should be between 1 and 100",
                                    "minLength": 1,
                                    "maxLength": 100
                                }
                            ],
                            "field": "name",
                            "help": "A unique name for this Anthropic organization.",
                            "required": true
                        },
                        {
                            "type": "text",
                            "label": "Admin API key",
                            "field": "api_key",
                            "encrypted": true,
                            "required": true,
                            "help": "Anthropic Admin API key (sk-ant-admin01-...). Created in Console > Settings > Organization."
                        },
                        {
                            "type": "text",
                            "label": "API base URL",
                            "field": "api_base_url",
                            "required": false,
                            "defaultValue": "https://api.anthropic.com",
                            "help": "Override for testing/proxies. The live demo fallback sets this to http://host.docker.internal:8081."
                        }
                    ],
                    "title": "Accounts"
                },
                {
                    "type": "loggingTab"
                }
            ],
            "title": "Configuration",
            "description": "Set up your add-on"
        },
        "inputs": {
            "services": [
                {
                    "name": "anthropic_usage",
                    "entity": [
                        {
                            "type": "text",
                            "label": "Name",
                            "validators": [
                                {
                                    "type": "regex",
                                    "errorMsg": "Input Name must begin with a letter and consist exclusively of alphanumeric characters and underscores.",
                                    "pattern": "^[a-zA-Z]\\w*$"
                                },
                                {
                                    "type": "string",
                                    "errorMsg": "Length of input name should be between 1 and 100",
                                    "minLength": 1,
                                    "maxLength": 100
                                }
                            ],
                            "field": "name",
                            "help": "A unique name for the data input.",
                            "required": true
                        },
                        {
                            "type": "singleSelect",
                            "label": "Account to use",
                            "options": {
                                "referenceName": "account"
                            },
                            "help": "Account to use for this input.",
                            "field": "account",
                            "required": true,
                            "validators": [
                                {
                                    "type": "string",
                                    "errorMsg": "Length of account name should be between 1 and 100",
                                    "minLength": 1,
                                    "maxLength": 100
                                }
                            ]
                        },
                        {
                            "type": "interval",
                            "label": "Interval",
                            "defaultValue": "300",
                            "field": "interval",
                            "options": {
                                "range": [
                                    10,
                                    86400
                                ]
                            },
                            "help": "Time interval of the data input, in seconds.",
                            "required": true
                        },
                        {
                            "type": "text",
                            "label": "Backfill days",
                            "field": "backfill_days",
                            "defaultValue": "7",
                            "required": false,
                            "help": "Days of history to ingest on first run (hourly buckets)."
                        },
                        {
                            "type": "index",
                            "field": "index",
                            "label": "Index"
                        }
                    ],
                    "inputHelperModule": "anthropic_usage_helper",
                    "title": "Anthropic Usage Report"
                },
                {
                    "name": "anthropic_cost",
                    "entity": [
                        {
                            "type": "text",
                            "label": "Name",
                            "validators": [
                                {
                                    "type": "regex",
                                    "errorMsg": "Input Name must begin with a letter and consist exclusively of alphanumeric characters and underscores.",
                                    "pattern": "^[a-zA-Z]\\w*$"
                                },
                                {
                                    "type": "string",
                                    "errorMsg": "Length of input name should be between 1 and 100",
                                    "minLength": 1,
                                    "maxLength": 100
                                }
                            ],
                            "field": "name",
                            "help": "A unique name for the data input.",
                            "required": true
                        },
                        {
                            "type": "singleSelect",
                            "label": "Account to use",
                            "options": {
                                "referenceName": "account"
                            },
                            "help": "Account to use for this input.",
                            "field": "account",
                            "required": true,
                            "validators": [
                                {
                                    "type": "string",
                                    "errorMsg": "Length of account name should be between 1 and 100",
                                    "minLength": 1,
                                    "maxLength": 100
                                }
                            ]
                        },
                        {
                            "type": "interval",
                            "label": "Interval",
                            "defaultValue": "3600",
                            "field": "interval",
                            "options": {
                                "range": [
                                    10,
                                    86400
                                ]
                            },
                            "help": "Time interval of the data input, in seconds.",
                            "required": true
                        },
                        {
                            "type": "text",
                            "label": "Backfill days",
                            "field": "backfill_days",
                            "defaultValue": "30",
                            "required": false,
                            "help": "Days of history to ingest on first run (daily buckets)."
                        },
                        {
                            "type": "index",
                            "field": "index",
                            "label": "Index"
                        }
                    ],
                    "inputHelperModule": "anthropic_cost_helper",
                    "title": "Anthropic Cost Report"
                },
                {
                    "name": "anthropic_directory",
                    "entity": [
                        {
                            "type": "text",
                            "label": "Name",
                            "validators": [
                                {
                                    "type": "regex",
                                    "errorMsg": "Input Name must begin with a letter and consist exclusively of alphanumeric characters and underscores.",
                                    "pattern": "^[a-zA-Z]\\w*$"
                                },
                                {
                                    "type": "string",
                                    "errorMsg": "Length of input name should be between 1 and 100",
                                    "minLength": 1,
                                    "maxLength": 100
                                }
                            ],
                            "field": "name",
                            "help": "A unique name for the data input.",
                            "required": true
                        },
                        {
                            "type": "singleSelect",
                            "label": "Account to use",
                            "options": {
                                "referenceName": "account"
                            },
                            "help": "Account to use for this input.",
                            "field": "account",
                            "required": true,
                            "validators": [
                                {
                                    "type": "string",
                                    "errorMsg": "Length of account name should be between 1 and 100",
                                    "minLength": 1,
                                    "maxLength": 100
                                }
                            ]
                        },
                        {
                            "type": "interval",
                            "label": "Interval",
                            "defaultValue": "3600",
                            "field": "interval",
                            "options": {
                                "range": [
                                    10,
                                    86400
                                ]
                            },
                            "help": "Time interval of the data input, in seconds.",
                            "required": true
                        },
                        {
                            "type": "index",
                            "field": "index",
                            "label": "Index"
                        }
                    ],
                    "inputHelperModule": "anthropic_directory_helper",
                    "title": "Anthropic Org Directory"
                }
            ],
            "title": "Inputs",
            "description": "Manage your data inputs",
            "table": {
                "actions": [
                    "edit",
